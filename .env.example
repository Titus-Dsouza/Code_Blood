# Copy to backend/.env and configure on the Django server.
DJANGO_SECRET_KEY=replace-with-a-random-server-only-value
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
FIREBASE_PROJECT_ID=your-firebase-project-id
# Provide GOOGLE_APPLICATION_CREDENTIALS as a server environment variable pointing outside this repository.
AADHAAR_HASH_SECRET=replace-with-a-long-random-server-only-secret
FRONTEND_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
LOGISTICS_NEWS_FEED_CONFIGURED=false
