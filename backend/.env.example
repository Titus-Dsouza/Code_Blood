DJANGO_SECRET_KEY=replace-with-a-random-server-only-value
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
FIREBASE_PROJECT_ID=your-firebase-project-id
# Set GOOGLE_APPLICATION_CREDENTIALS to a service account file path, or use ADC.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
AADHAAR_HASH_SECRET=replace-with-a-long-random-server-only-secret
FRONTEND_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:5501,http://127.0.0.1:5501
# Set true only when an actual trusted logistics news feed is wired into Firestore.
LOGISTICS_NEWS_FEED_CONFIGURED=false
